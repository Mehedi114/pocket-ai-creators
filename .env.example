# ==========================================================
# Pocket AI — Environment Variables
# ==========================================================
# Vercel: Project → Settings → Environment Variables এ যোগ করুন
# Local:  এই ফাইল কপি করে `.env` নাম দিন এবং key বসান
#
# শুধু যেগুলোর key আছে সেগুলোই active হবে।
# একটার rate limit শেষ হলে ইঞ্জিন অটোমেটিক পরেরটায় চলে যাবে।
# ==========================================================

# --- ১. Groq (সবচেয়ে দ্রুত, কার্ড লাগে না) --------------
# https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- ২. Cerebras (অসম্ভব fast, কার্ড লাগে না) ------------
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# --- ৩. Google Gemini (1M context, ভালো বাংলা) ----------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- ৪. NVIDIA NIM (১২৫+ ফ্রি মডেল) ---------------------
# https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- ৫. Mistral AI --------------------------------------
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# --- ৬. GitHub Models (আপনার GitHub PAT দিয়েই চলে) ------
# https://github.com/marketplace/models
GITHUB_MODELS_TOKEN=
# GITHUB_MODEL=openai/gpt-4.1-mini

# --- ৭. OpenRouter (এক key-তে ২৭+ ফ্রি মডেল) ------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# --- ৮. SambaNova ---------------------------------------
# https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
# SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# --- ৯. Hugging Face Router -----------------------------
# https://huggingface.co/settings/tokens
HF_TOKEN=
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- ১০. Together AI (-Free মডেল ফ্রি) ------------------
# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

# --- ১১. Z AI / GLM (GLM-4-Flash চিরস্থায়ী ফ্রি) --------
# https://open.bigmodel.cn/usercenter/apikeys
ZAI_API_KEY=
# ZAI_MODEL=glm-4-flash

# --- ১২. LLM7.io (key ছাড়াও চলে — safety net) -----------
# https://token.llm7.io/
LLM7_API_KEY=unused
# LLM7_MODEL=gpt-5-nano

# --- YouTube Data API v3 (Creator Research এর জন্য) -----
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ==========================================================
# Engine tuning (ঐচ্ছিক)
# ==========================================================
# কোন ক্রমে প্রোভাইডার চেষ্টা করবে (কমা দিয়ে)
# AI_PROVIDER_ORDER=groq,cerebras,gemini,nvidia,mistral,github,openrouter,sambanova,huggingface,together,zai,llm7

# কোনগুলো বন্ধ রাখবে
# AI_PROVIDER_DISABLED=

# Power Mode এ একসাথে কয়টা AI জিজ্ঞেস করবে
# AI_COUNCIL_SIZE=3

# প্রতি রিকোয়েস্টে সর্বোচ্চ অপেক্ষা (ms)
# AI_TIMEOUT_MS=45000

# --- ১৩. Custom / Self-hosted (Ollama, LM Studio, vLLM...) ---
# CUSTOM_BASE_URL সেট করলেই এটি চালু হবে
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_API_KEY=ollama
# CUSTOM_MODEL=llama3.1

# যেকোনো প্রোভাইডারের endpoint বদলাতে: <ID>_BASE_URL
# যেমন: GROQ_BASE_URL=https://api.groq.com/openai/v1

# ==========================================================
# Creator Services (LLM-এর বাইরের ফ্রি API)
# ==========================================================

# --- ইমেজ + ভয়েস: Pollinations ---------------------------
# key ছাড়াই চলে। token দিলে watermark ওঠে + লিমিট বাড়ে।
# https://auth.pollinations.ai/
# POLLINATIONS_TOKEN=
# POLLINATIONS_MODEL=flux

# --- যেকোনো URL পড়া: Jina Reader ------------------------
# key ছাড়া ~20 req/min। ফ্রি key দিলে 500 RPM + 10M টোকেন।
# https://jina.ai/api-dashboard/
# JINA_API_KEY=

# --- লাইভ ওয়েব সার্চ: Tavily ----------------------------
# ফ্রি ১০০০ সার্চ/মাস, কার্ড লাগে না
# https://app.tavily.com/home
# TAVILY_API_KEY=

# --- ট্রান্সক্রিপশন: Groq Whisper ------------------------
# উপরের GROQ_API_KEY দিয়েই চলে, আলাদা কিছু লাগে না
# WHISPER_MODEL=whisper-large-v3-turbo
